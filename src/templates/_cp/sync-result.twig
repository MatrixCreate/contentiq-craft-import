{% extends '_layouts/cp' %}

{% set title = 'Sync Report' %}

{% set crumbs = [
    { label: 'ContentiQ', url: url('contentiq-importer') },
] %}

{% block actionButton %}
    <a class="btn submit" href="{{ url('contentiq-importer/sync') }}">
        {{ 'Sync Again'|t('contentiq-importer') }}
    </a>
{% endblock %}

{# Recursive macro for rendering page tree rows #}
{% macro pageRows(slugs, slugToPage, childrenOf, depth) %}
    {% for slug in slugs %}
        {% set page = slugToPage[slug] ?? null %}
        {% if page %}
            {% set indent = depth * 24 %}
            {% set isLocked = 'Skipped — entry is locked.' in (page.warnings ?? []) %}
            <tr>
                <td style="padding-left:{{ 12 + indent }}px;">
                    {% if depth > 0 %}
                        <span style="color:var(--hairline-color); margin-right:4px;">{% for i in 1..depth %}&mdash;{% endfor %}</span>
                    {% endif %}
                    <strong>{{ page.title ?? page.slug ?? '?' }}</strong>
                    {% if page.sectionLabel ?? null %}
                        <span class="light" style="margin-left:6px;">— {{ page.sectionLabel }}</span>
                    {% endif %}
                    {% set otherWarnings = (page.warnings ?? [])|filter(w => w != 'Skipped — entry is locked.') %}
                    {% if isLocked %}
                        <span class="light" style="margin-left:6px;">— Skipped (locked)</span>
                    {% endif %}
                    {% if page.error ?? null %}
                        <span style="color:var(--error-color); margin-left:6px;">— {{ page.error }}</span>
                    {% endif %}
                    {% for warning in otherWarnings %}
                        <span style="color:var(--warning-color); margin-left:6px;">— {{ warning }}</span>
                    {% endfor %}
                </td>
                <td><code style="font-size:12px;">{{ page.slug ?? '?' }}</code></td>
                <td>
                    {% if 'Skipped — entry is locked.' in (page.warnings ?? []) %}
                        <span class="status disabled"></span> Locked
                    {% elseif page.skipped ?? false %}
                        <span class="status disabled"></span> Skipped
                    {% elseif page.success ?? false %}
                        {% if page.entryFound ?? false %}
                            <span class="status blue"></span> Updated
                        {% else %}
                            <span class="status green"></span> Created
                        {% endif %}
                    {% else %}
                        <span class="status red"></span> Failed
                    {% endif %}
                </td>
                <td class="thin" style="white-space:nowrap;">
                    {% if page.entryId ?? null %}
                        {% set pageEntry = craft.entries.id(page.entryId).status(null).one() %}
                        {% if pageEntry %}
                            <a href="{{ pageEntry.cpEditUrl }}" class="btn small" title="Edit in CP">
                                {{ 'Edit'|t('contentiq-importer') }}
                            </a>
                            {% if pageEntry.url %}
                                <a href="{{ pageEntry.url }}" class="btn small" target="_blank" title="View on site">
                                    {{ 'View'|t('contentiq-importer') }}
                                </a>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </td>
            </tr>


            {# Recurse into children #}
            {% set children = childrenOf[slug] ?? [] %}
            {% if children|length %}
                {{ _self.pageRows(children, slugToPage, childrenOf, depth + 1) }}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block content %}

    {# Overall status banner #}
    {% if run.status == 'success' %}
        <div class="pane" style="background:var(--green-050); border:1px solid var(--green-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <span class="status green"></span>
            <strong>{{ 'Sync completed successfully'|t('contentiq-importer') }}</strong>
        </div>
    {% elseif run.status == 'warnings' %}
        <div class="pane" style="background:var(--yellow-050); border:1px solid var(--yellow-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <span class="status orange"></span>
            <strong>{{ 'Sync completed with warnings'|t('contentiq-importer') }}</strong>
        </div>
    {% else %}
        <div class="pane" style="background:var(--red-050); border:1px solid var(--red-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <span class="status red"></span>
            <strong>{{ 'Sync completed with errors'|t('contentiq-importer') }}</strong>
        </div>
    {% endif %}

    {# Summary line.
       'updated' = entries actually written/saved to Craft, 'skipped' = locked or
       any other skip reason, 'total' = pages found in the API response. Locked
       and skipped pages appear in run.result but are never written, so counting
       them separately keeps the headline figure honest. #}
    {% set pages = run.result ?? [] %}
    {% set totalImages = 0 %}
    {% set reusedImages = 0 %}
    {% set totalWarnings = 0 %}
    {% set updatedCount = 0 %}
    {% set skippedCount = 0 %}
    {% for page in pages %}
        {% for img in page.images ?? [] %}
            {% set totalImages = totalImages + 1 %}
            {% if img.reused %}
                {% set reusedImages = reusedImages + 1 %}
            {% endif %}
        {% endfor %}
        {% set totalWarnings = totalWarnings + (page.warnings ?? [])|length %}

        {% set isLocked = 'Skipped — entry is locked.' in (page.warnings ?? []) %}
        {% set isSkipped = (page.skipped ?? false) or isLocked %}
        {% if isSkipped %}
            {% set skippedCount = skippedCount + 1 %}
        {% elseif page.success ?? false %}
            {% set updatedCount = updatedCount + 1 %}
        {% endif %}
    {% endfor %}

    <div style="margin-bottom:24px; font-size:14px; color:var(--text-color);">
        <strong>{{ updatedCount }}</strong> updated
        &middot; <strong>{{ skippedCount }}</strong> skipped
        &middot; <strong>{{ pages|length }}</strong> total
        &middot; <strong>{{ totalImages - reusedImages }}</strong> images downloaded
        &middot; <strong>{{ reusedImages }}</strong> images reused
        {% if totalWarnings > 0 %}
            &middot; <strong style="color:var(--warning-color);">{{ totalWarnings }}</strong> {{ totalWarnings == 1 ? 'warning' : 'warnings' }}
        {% endif %}
    </div>

    {# Warnings panel — list every warning with its page so totals match details. #}
    {% set warningPages = [] %}
    {% for page in pages %}
        {% if (page.warnings ?? [])|length > 0 %}
            {% set warningPages = warningPages|merge([page]) %}
        {% endif %}
    {% endfor %}

    {% if warningPages|length %}
        {# Collapsed by default — the "See more" label toggles the hidden checkbox,
           expanding the list via a grid-rows transition (no JS, exact height). #}
        {% css %}
            .cq-warnings .cq-warn-toggle { position:absolute; width:1px; height:1px; opacity:0; pointer-events:none; }
            .cq-warnings .cq-warn-header { display:flex; align-items:center; justify-content:space-between; gap:12px; }
            .cq-warnings .cq-warn-header h2 { margin:0; font-size:14px; }
            .cq-warnings .cq-warn-link { cursor:pointer; color:var(--link-color, #2563eb); text-decoration:underline; font-size:13px; white-space:nowrap; }
            .cq-warnings .cq-warn-link::after { content:'See more'; }
            .cq-warnings .cq-warn-toggle:checked ~ .cq-warn-header .cq-warn-link::after { content:'See less'; }
            .cq-warnings .cq-warn-body { display:grid; grid-template-rows:0fr; transition:grid-template-rows .35s ease; }
            .cq-warnings .cq-warn-toggle:checked ~ .cq-warn-body { grid-template-rows:1fr; }
            .cq-warnings .cq-warn-inner { overflow:hidden; min-height:0; }
            .cq-warnings .cq-warn-inner ul { margin:12px 0 0 0; padding-left:20px; }
        {% endcss %}

        <div class="pane cq-warnings" style="background:var(--yellow-050); border:1px solid var(--yellow-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <input type="checkbox" id="cq-warn-toggle" class="cq-warn-toggle">
            <div class="cq-warn-header">
                <h2>
                    {{ 'Warnings'|t('contentiq-importer') }}
                    <span class="light" style="font-weight:normal;">({{ totalWarnings }})</span>
                </h2>
                <label for="cq-warn-toggle" class="cq-warn-link"></label>
            </div>
            <div class="cq-warn-body">
                <div class="cq-warn-inner">
                    <ul>
                        {% for page in warningPages %}
                            {% for warning in page.warnings %}
                                <li style="margin-bottom:4px;">
                                    <strong>{{ page.title ?? page.slug ?? '?' }}</strong>
                                    <code style="font-size:12px; color:var(--medium-text-color);">{{ page.slug ?? '?' }}</code>
                                    — {{ warning }}
                                </li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% endif %}

    {# Build tree lookup maps from parentSlug. First pass collects every slug so
       the second pass can detect orphans — pages whose parent isn't in this
       batch — and surface them as roots instead of silently dropping them. #}
    {% set slugToPage = {} %}
    {% for page in pages %}
        {% set slug = page.slug ?? '' %}
        {% set slugToPage = slugToPage|merge({ (slug): page }) %}
    {% endfor %}

    {% set childrenOf = {} %}
    {% set rootSlugs = [] %}

    {% for page in pages %}
        {% set slug = page.slug ?? '' %}
        {% set parentSlug = page.parentSlug ?? null %}
        {% set parentInBatch = parentSlug and parentSlug != '' and slugToPage[parentSlug] is defined %}

        {% if parentInBatch %}
            {% set existing = childrenOf[parentSlug] ?? [] %}
            {% set childrenOf = childrenOf|merge({ (parentSlug): existing|merge([slug]) }) %}
        {% else %}
            {% set rootSlugs = rootSlugs|merge([slug]) %}
        {% endif %}
    {% endfor %}

    {# Hierarchical page tree #}
    <div class="pane" style="border-radius:8px;">
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Page'|t('contentiq-importer') }}</th>
                    <th>{{ 'Slug'|t('contentiq-importer') }}</th>
                    <th>{{ 'Status'|t('contentiq-importer') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{ _self.pageRows(rootSlugs, slugToPage, childrenOf, 0) }}
            </tbody>
        </table>
    </div>

{% endblock %}
