{% extends '_layouts/cp' %}

{% set title = 'Sync from ContentiQ' %}

{% set crumbs = [
    { label: 'ContentiQ', url: url('contentiq-importer') },
] %}

{# Recursive macro for rendering the entry tree with checkboxes #}
{% macro pageRows(slugs, slugToPage, childrenOf, depth) %}
    {% for slug in slugs %}
        {% set page = slugToPage[slug] ?? null %}
        {% if page %}
            {% set indent = depth * 24 %}
            {% set isNew = page.isNew ?? false %}
            <tr data-element-id="{{ page.elementId }}" data-depth="{{ depth }}" data-is-new="{{ isNew ? '1' : '0' }}">
                <td style="padding-left:{{ 12 + indent }}px; white-space:nowrap;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox"
                               class="contentiq-sync-cb"
                               {% if page.elementId ?? null %}data-element-id="{{ page.elementId }}"{% endif %}
                               {% if isNew and (page.contentiqPageId ?? null) %}data-contentiq-page-id="{{ page.contentiqPageId }}"{% endif %}
                               {{ (isNew or not page.locked) ? 'checked' : '' }}>
                        <strong>{{ page.title ?? page.slug }}</strong>
                        {% if page.isHomepage ?? false %}
                            <span class="light" style="font-size:12px;">(Homepage)</span>
                        {% endif %}
                    </label>
                </td>
                <td><code style="font-size:12px;">{{ page.slug ?? '?' }}</code></td>
                <td class="contentiq-status-cell" style="white-space:nowrap;">
                    {% if isNew %}
                        <span class="status blue"></span> <span class="contentiq-status-text">New</span>
                    {% elseif page.locked %}
                        <span class="status disabled"></span> <span class="contentiq-status-text">Locked</span>
                    {% else %}
                        <span class="status green"></span> <span class="contentiq-status-text">Will sync</span>
                    {% endif %}
                </td>
            </tr>

            {# Recurse into children #}
            {% set children = childrenOf[slug] ?? [] %}
            {% if children|length %}
                {{ _self.pageRows(children, slugToPage, childrenOf, depth + 1) }}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block content %}

    <div style="max-width:900px;">

        {# Dismissible warning — API unconfigured or unreachable. The tree
           below still renders, but from local sync records only (see
           CpController::actionSync()'s graceful-degradation fallback). #}
        {% if apiWarning ?? null %}
            <div class="pane" id="contentiq-api-warning" style="background:var(--yellow-050); border:1px solid var(--yellow-300); margin-bottom:24px; padding:12px 16px; border-radius:8px; display:flex; justify-content:space-between; align-items:center; gap:12px;">
                <span style="font-size:13px;">{{ apiWarning }}</span>
                <button type="button" class="btn small" onclick="document.getElementById('contentiq-api-warning').remove();">{{ 'Dismiss'|t('contentiq-importer') }}</button>
            </div>
        {% endif %}

        {# Sync controls + API info #}
        <div class="pane" style="padding:24px; border-radius:8px; margin-bottom:24px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">

                {# API info (right) #}
                <div style="display:flex; gap:48px;">
                    <div>
                        <div class="light" style="margin-bottom:4px; font-size:13px;">ContentiQ Instance</div>
                        <div><strong>{{ contentiqUrl }}</strong></div>
                    </div>
                    <div>
                        <div class="light" style="margin-bottom:4px; font-size:13px;">Project</div>
                        <div><strong>{{ projectSlug }}</strong></div>
                    </div>
                </div>

                {# Sync button + hint (left) #}
                <div id="sync-idle" style="display:flex; align-items:center; gap:12px;">
                    <form method="post" id="sync-form" style="display:flex; align-items:center; gap:12px;">
                        {% if hasSyncRecords %}
                            <span class="light" style="font-size:13px;" id="contentiq-sync-btn-hint"></span>
                        {% endif %}
                        {{ csrfInput() }}
                        {{ actionInput('contentiq-importer/cp/run-sync') }}
                        <button type="submit" class="btn submit">
                            {{ 'Sync'|t('contentiq-importer') }}
                        </button>
                    </form>
                </div>

                {# Loading state — shown while job is running #}
                <div id="sync-loading" style="display:none;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div class="spinner" style="display:block;"></div>
                        <div>
                            <strong>{{ 'Syncing content and downloading assets'|t('contentiq-importer') }}</strong>
                            <div class="light" style="font-size:13px; margin-top:2px;">{{ 'This may take a moment for large imports.'|t('contentiq-importer') }}</div>
                        </div>
                    </div>
                </div>

                {# Error state #}
                <div id="sync-error" style="display:none;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div class="error">
                            <strong>{{ 'Sync failed'|t('contentiq-importer') }}</strong>
                            <span id="sync-error-message"></span>
                        </div>
                        <button type="button" class="btn small" onclick="resetSync()">{{ 'Try Again'|t('contentiq-importer') }}</button>
                    </div>
                </div>
            </div>
        </div>

        {# Globals consent — one checkbox gates the whole globals payload. #}
        <div class="pane" style="border-radius:8px; margin-bottom:24px;">
            <div style="padding:12px 16px; border-bottom:1px solid var(--hairline-color);">
                <strong style="text-transform:uppercase; letter-spacing:0.05em; font-size:11px; color:var(--medium-text-color);">{{ 'Globals'|t('contentiq-importer') }}</strong>
            </div>
            <div style="padding:12px 16px;">
                <label style="display:flex; align-items:flex-start; gap:10px; cursor:pointer;">
                    <input type="checkbox" id="contentiq-globals-cb" {{ not globalsLocked ? 'checked' : '' }}>
                    <span>
                        <strong>{{ 'Sync company, offices, branding and scripts'|t('contentiq-importer') }}</strong>
                        <span class="light" style="display:block; font-size:12px; margin-top:2px;">
                            {{ globalsOfficeCount }} {{ globalsOfficeCount == 1 ? 'office' : 'offices' }} mapped
                            &middot; {{ globalsSetNames|join(', ') }}
                        </span>
                        <span class="light" style="display:block; font-size:12px; margin-top:2px;">
                            {{ 'Overwrites the offices section and the global sets above. Unchecked = left unchanged.'|t('contentiq-importer') }}
                        </span>
                    </span>
                </label>
            </div>
        </div>

        {% if hasSyncRecords %}

            {# Entry tree pane with selection controls #}
            <div class="pane" style="border-radius:8px; margin-bottom:24px;">

                {# Header bar #}
                <div style="padding:12px 16px; border-bottom:1px solid var(--hairline-color); display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <strong>{{ 'Entries'|t('contentiq-importer') }}</strong>
                        <span class="light" style="margin-left:8px; font-size:13px;" id="contentiq-sync-summary"></span>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button type="button" class="btn small" id="contentiq-select-all">{{ 'Select All'|t('contentiq-importer') }}</button>
                        <button type="button" class="btn small" id="contentiq-select-none">{{ 'Select None'|t('contentiq-importer') }}</button>
                    </div>
                </div>

                {# Hint #}
                <div style="padding:10px 16px; background:var(--gray-050); border-bottom:1px solid var(--hairline-color); font-size:13px; color:var(--medium-text-color);">
                    Select the entries you want to update. Unselected entries will not be changed. <strong>New</strong> entries have never been imported — unchecking one skips it for this sync only; it will reappear as New next time.
                </div>

                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>{{ 'Title'|t('contentiq-importer') }}</th>
                            <th>{{ 'Slug'|t('contentiq-importer') }}</th>
                            <th>{{ 'Status'|t('contentiq-importer') }}</th>
                        </tr>
                    </thead>

                    {# One tbody per section group, each headed by a section label. #}
                    {% for group in syncGroups %}

                        {# Build tree lookup maps scoped to this group #}
                        {% set slugToPage = {} %}
                        {% set childrenOf = {} %}
                        {% set rootSlugs = [] %}

                        {% for entry in group.entries %}
                            {% set slug = entry.slug ?? '' %}
                            {% set parentSlug = entry.parentSlug ?? null %}
                            {% set slugToPage = slugToPage|merge({ (slug): entry }) %}

                            {% if parentSlug and parentSlug != '' %}
                                {% set existing = childrenOf[parentSlug] ?? [] %}
                                {% set childrenOf = childrenOf|merge({ (parentSlug): existing|merge([slug]) }) %}
                            {% else %}
                                {% set rootSlugs = rootSlugs|merge([slug]) %}
                            {% endif %}
                        {% endfor %}

                        <tbody>
                            <tr>
                                <td colspan="3" style="background:var(--gray-050); border-top:1px solid var(--hairline-color); padding:8px 12px;">
                                    <strong style="text-transform:uppercase; letter-spacing:0.05em; font-size:11px; color:var(--medium-text-color);">{{ group.name }}</strong>
                                </td>
                            </tr>
                            {{ _self.pageRows(rootSlugs, slugToPage, childrenOf, 0) }}
                        </tbody>

                    {% endfor %}
                </table>
            </div>

        {% endif %}

    </div>

    <script>
    (function() {
        var form = document.getElementById('sync-form');
        var idleEl = document.getElementById('sync-idle');
        var loadingEl = document.getElementById('sync-loading');
        var errorEl = document.getElementById('sync-error');
        var errorMsg = document.getElementById('sync-error-message');
        var runId = null;
        var pollTimer = null;

        // ----- Tree checkbox logic -----
        // Checked = will sync, unchecked = locked (won't sync).
        var checkboxes = Array.from(document.querySelectorAll('.contentiq-sync-cb'));
        var lastCheckedIndex = null;
        var summaryEl = document.getElementById('contentiq-sync-summary');
        var btnHintEl = document.getElementById('contentiq-sync-btn-hint');

        function updateStatusCell(cb) {
            var row = cb.closest('tr');
            var cell = row.querySelector('.contentiq-status-cell');
            if (!cell) return;

            // New (never-imported) rows are now toggleable — unchecking one
            // excludes it from this sync only (see excludeNewIds below); it
            // reappears as New next time since nothing gets written for it.
            if (row.dataset.isNew === '1') {
                if (cb.checked) {
                    cell.innerHTML = '<span class="status blue"></span> <span class="contentiq-status-text">New</span>';
                } else {
                    cell.innerHTML = '<span class="status disabled"></span> <span class="contentiq-status-text">New — skipped</span>';
                }
            } else if (cb.checked) {
                cell.innerHTML = '<span class="status green"></span> <span class="contentiq-status-text">Will sync</span>';
            } else {
                cell.innerHTML = '<span class="status disabled"></span> <span class="contentiq-status-text">Locked</span>';
            }
        }

        function updateSummary() {
            if (!checkboxes.length) return;

            var selected = checkboxes.filter(function(cb) { return cb.checked; }).length;
            var total = checkboxes.length;

            if (summaryEl) {
                summaryEl.textContent = selected + ' of ' + total + ' selected';
            }
            if (btnHintEl) {
                if (selected === 0) {
                    btnHintEl.textContent = 'No entries selected — nothing will be synced.';
                } else {
                    btnHintEl.textContent = selected + ' ' + (selected === 1 ? 'entry' : 'entries') + ' will be updated.';
                }
            }
        }

        // Shift-click range selection.
        checkboxes.forEach(function(cb, index) {
            cb.addEventListener('click', function(e) {
                if (e.shiftKey && lastCheckedIndex !== null) {
                    var start = Math.min(lastCheckedIndex, index);
                    var end = Math.max(lastCheckedIndex, index);
                    var state = cb.checked;
                    for (var i = start; i <= end; i++) {
                        checkboxes[i].checked = state;
                        updateStatusCell(checkboxes[i]);
                    }
                }
                lastCheckedIndex = index;
                updateStatusCell(cb);
                updateSummary();
            });
        });

        // Select All / Select None buttons.
        var selectAllBtn = document.getElementById('contentiq-select-all');
        var selectNoneBtn = document.getElementById('contentiq-select-none');

        if (selectAllBtn) {
            selectAllBtn.addEventListener('click', function() {
                checkboxes.forEach(function(cb) { cb.checked = true; updateStatusCell(cb); });
                updateSummary();
            });
        }
        if (selectNoneBtn) {
            selectNoneBtn.addEventListener('click', function() {
                checkboxes.forEach(function(cb) { cb.checked = false; updateStatusCell(cb); });
                updateSummary();
            });
        }

        // Initial summary.
        updateSummary();

        // ----- Sync form submission -----
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            idleEl.style.display = 'none';
            loadingEl.style.display = 'block';
            errorEl.style.display = 'none';

            var formData = new FormData(form);

            // Collect selected entry IDs (checked = will sync = unlock).
            // "New" rows (never imported) have no data-element-id — there's
            // no lock row to unlock for them, they're excluded separately
            // below via excludeNewIds.
            if (checkboxes.length) {
                var unlockIds = [];
                checkboxes.forEach(function(cb) {
                    if (cb.checked && cb.dataset.elementId) {
                        unlockIds.push(parseInt(cb.dataset.elementId, 10));
                    }
                });
                formData.append('unlockIds', JSON.stringify(unlockIds));
            }

            // Collect ContentIQ page IDs for UNCHECKED "New" rows — these are
            // skipped for this sync only (they have no lock row to unlock, so
            // unlockIds above can't express "don't import this one"). If JS
            // is broken or an id is missing, nothing is excluded and the
            // page imports as before — never silently skip by default.
            if (checkboxes.length) {
                var excludeNewIds = [];
                checkboxes.forEach(function(cb) {
                    var row = cb.closest('tr');
                    if (row && row.dataset.isNew === '1' && !cb.checked && cb.dataset.contentiqPageId) {
                        excludeNewIds.push(parseInt(cb.dataset.contentiqPageId, 10));
                    }
                });
                formData.append('excludeNewIds', JSON.stringify(excludeNewIds));
            }

            // Globals consent — checked = sync (unlock) this run.
            var globalsCb = document.getElementById('contentiq-globals-cb');
            formData.append('unlockGlobals', globalsCb && globalsCb.checked ? '1' : '0');

            fetch(Craft.getActionUrl('contentiq-importer/cp/run-sync'), {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body: formData,
            })
            .then(function(resp) { return resp.json(); })
            .then(function(data) {
                if (data.success && data.runId) {
                    runId = data.runId;
                    // Kick Craft's queue runner so the job starts immediately.
                    Craft.postActionRequest('queue/run');
                    pollForCompletion();
                } else {
                    showError(data.error || 'An unexpected error occurred.');
                }
            })
            .catch(function(err) {
                showError(err.message || 'Network error.');
            });
        });

        function pollForCompletion() {
            pollTimer = setInterval(function() {
                fetch(Craft.getCpUrl('contentiq-importer/sync/status') + '?runId=' + runId, {
                    headers: { 'Accept': 'application/json' },
                })
                .then(function(resp) { return resp.json(); })
                .then(function(data) {
                    if (data.status === 'pending') {
                        // Still running — keep polling.
                        return;
                    }
                    clearInterval(pollTimer);
                    // Redirect to sync report.
                    window.location.href = Craft.getCpUrl('contentiq-importer/sync/result/' + runId);
                })
                .catch(function() {
                    // Polling error — keep trying silently.
                });
            }, 2000);
        }

        function showError(msg) {
            loadingEl.style.display = 'none';
            errorEl.style.display = 'block';
            errorMsg.textContent = msg;
        }

        window.resetSync = function() {
            errorEl.style.display = 'none';
            idleEl.style.display = 'block';
        };
    })();
    </script>

{% endblock %}
